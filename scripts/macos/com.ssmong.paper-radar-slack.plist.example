<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.ssmong.paper-radar-slack</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>__REPO_ROOT__/scripts/macos/run_slack_review_bot.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__REPO_ROOT__</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PAPER_RADAR_REPO_ROOT</key>
    <string>__REPO_ROOT__</string>
    <key>PAPER_RADAR_BOT_PYTHON</key>
    <string>__REPO_ROOT__/.venv/bin/python3</string>
    <key>CODEX_BIN</key>
    <string>__CODEX_BIN__</string>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>__LOG_DIR__/paper-radar-slack.out.log</string>
  <key>StandardErrorPath</key>
  <string>__LOG_DIR__/paper-radar-slack.err.log</string>
</dict>
</plist>
