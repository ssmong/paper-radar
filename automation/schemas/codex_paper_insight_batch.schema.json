{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Codex full-text paper insight batch",
  "type": "object",
  "properties": {
    "results": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "properties": {
          "paper_id": { "type": "string", "minLength": 1, "maxLength": 100 },
          "problem": { "type": "string", "minLength": 1, "maxLength": 3000 },
          "method": { "type": "string", "minLength": 1, "maxLength": 3000 },
          "contribution": { "type": "string", "minLength": 1, "maxLength": 3000 },
          "limitations": {
            "type": "array",
            "maxItems": 4,
            "items": { "type": "string", "minLength": 1, "maxLength": 2000 }
          },
          "gap_candidate": { "type": "string", "minLength": 1, "maxLength": 3000 },
          "comparisons": {
            "type": "array",
            "maxItems": 6,
            "items": {
              "type": "object",
              "properties": {
                "task": { "type": "string", "maxLength": 1000 },
                "dataset": { "type": "string", "maxLength": 1000 },
                "metric": { "type": "string", "maxLength": 1000 },
                "proposed_value": { "type": "number" },
                "baseline_name": { "type": "string", "maxLength": 1000 },
                "baseline_value": { "type": "number" },
                "unit": { "type": "string", "maxLength": 200 },
                "higher_is_better": { "type": ["boolean", "null"] },
                "conditions_match": { "type": "boolean" },
                "comparison_note": { "type": "string", "maxLength": 2000 },
                "proposed_evidence": { "type": "string", "minLength": 1, "maxLength": 2000 },
                "baseline_evidence": { "type": "string", "minLength": 1, "maxLength": 2000 }
              },
              "required": [
                "task",
                "dataset",
                "metric",
                "proposed_value",
                "baseline_name",
                "baseline_value",
                "unit",
                "higher_is_better",
                "conditions_match",
                "comparison_note",
                "proposed_evidence",
                "baseline_evidence"
              ],
              "additionalProperties": false
            }
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": { "type": "string", "minLength": 1, "maxLength": 2000 }
          }
        },
        "required": [
          "paper_id",
          "problem",
          "method",
          "contribution",
          "limitations",
          "gap_candidate",
          "comparisons",
          "evidence"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": ["results"],
  "additionalProperties": false
}
